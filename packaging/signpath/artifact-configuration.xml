<?xml version="1.0" encoding="utf-8"?>
<!--
  Paste this into SignPath (Project, Artifact configuration, "default") once the project
  is approved. The release workflow uploads the installer as a zip with one .exe in it.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Muted-Setup-*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
