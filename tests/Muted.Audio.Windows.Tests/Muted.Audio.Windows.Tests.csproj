<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Muted.Audio.Windows\Muted.Audio.Windows.csproj" />
    <ProjectReference Include="..\..\src\Muted.App\Muted.App.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\src\Muted.Audio.Windows\runtimes\win-x64\native\rnnoise.dll')">
    <Content Include="..\..\src\Muted.Audio.Windows\runtimes\win-x64\native\rnnoise.dll">
      <Link>rnnoise.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- A clean speech sample, so the model tests measure what real speech keeps. -->
  <ItemGroup Condition="Exists('fixtures\speech-48k-mono.wav')">
    <Content Include="fixtures\speech-48k-mono.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Microsoft's DNSMOS P.835 quality model (CC-BY-4.0), for the quality harness only. -->
    <Content Include="fixtures\dnsmos-sig_bak_ovr.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The checksum tests read the models the app ships, so they come along too. -->
  <ItemGroup Condition="Exists('..\..\src\Muted.Audio.Windows\models\deepfilternet3.onnx')">
    <Content Include="..\..\src\Muted.Audio.Windows\models\deepfilternet3.onnx">
      <Link>models\deepfilternet3.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\deepfilternet3.onnx.sha256">
      <Link>models\deepfilternet3.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\dpdfnet2_48khz_hr.onnx">
      <Link>models\dpdfnet2_48khz_hr.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\dpdfnet2_48khz_hr.onnx.sha256">
      <Link>models\dpdfnet2_48khz_hr.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\dpdfnet8_48khz_hr.onnx">
      <Link>models\dpdfnet8_48khz_hr.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\dpdfnet8_48khz_hr.onnx.sha256">
      <Link>models\dpdfnet8_48khz_hr.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-encoder.onnx')">
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-encoder.onnx">
      <Link>models\whisper-tiny.en-encoder.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-encoder.onnx.sha256">
      <Link>models\whisper-tiny.en-encoder.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-decoder.onnx">
      <Link>models\whisper-tiny.en-decoder.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-decoder.onnx.sha256">
      <Link>models\whisper-tiny.en-decoder.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-tokens.txt">
      <Link>models\whisper-tiny.en-tokens.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\whisper-tiny.en-tokens.txt.sha256">
      <Link>models\whisper-tiny.en-tokens.txt.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\wespeaker-campplus.onnx">
      <Link>models\wespeaker-campplus.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Muted.Audio.Windows\models\wespeaker-campplus.onnx.sha256">
      <Link>models\wespeaker-campplus.onnx.sha256</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
