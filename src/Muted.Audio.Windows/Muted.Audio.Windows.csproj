<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Muted.Core\Muted.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup Condition="Exists('runtimes\win-x64\native\rnnoise.dll')">
    <Content Include="runtimes\win-x64\native\rnnoise.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>rnnoise.dll</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Studio Voice (DeepFilterNet3). The SHA-256 next to it is checked by the release package. -->
  <ItemGroup Condition="Exists('models\deepfilternet3.onnx')">
    <Content Include="models\deepfilternet3.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\deepfilternet3.onnx</TargetPath>
    </Content>
    <Content Include="models\deepfilternet3.onnx.sha256">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\deepfilternet3.onnx.sha256</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Studio Voice: the two DPDFNet variants, Balanced and Maximum quality. -->
  <ItemGroup Condition="Exists('models\dpdfnet2_48khz_hr.onnx')">
    <Content Include="models\dpdfnet2_48khz_hr.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\dpdfnet2_48khz_hr.onnx</TargetPath>
    </Content>
    <Content Include="models\dpdfnet2_48khz_hr.onnx.sha256">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\dpdfnet2_48khz_hr.onnx.sha256</TargetPath>
    </Content>
    <Content Include="models\dpdfnet8_48khz_hr.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\dpdfnet8_48khz_hr.onnx</TargetPath>
    </Content>
    <Content Include="models\dpdfnet8_48khz_hr.onnx.sha256">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>models\dpdfnet8_48khz_hr.onnx.sha256</TargetPath>
    </Content>
  </ItemGroup>

</Project>
