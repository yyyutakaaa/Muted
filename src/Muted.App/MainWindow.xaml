<Window x:Class="Muted.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Muted.App.Views"
        Title="Muted"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="1180" Height="820"
        MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Switch that reflects IsRunning and fires ToggleCommand; visual state
             follows the view model so a failed start never leaves a stale "on". -->
        <Style x:Key="RunSwitchStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="46" Height="26">
                            <Border Background="{StaticResource ToggleTrackBrush}" CornerRadius="13" />
                            <Border x:Name="TrackOn"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="13"
                                    Opacity="0" />
                            <Ellipse x:Name="Thumb"
                                     Width="20" Height="20" Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource ToggleThumbBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,22,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" Margin="3,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="4" Height="30" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" Margin="3,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" Margin="3,0,0,0" VerticalAlignment="Center" />
                    <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}" Margin="3,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Text="Muted" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="14,0">
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE80F;"
                             Content="Dashboard"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dashboard}" />
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE9E9;"
                             Content="Audio"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Audio}" />
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE765;"
                             Content="Shortcuts"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Shortcuts}" />
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE713;"
                             Content="Settings"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Settings}" />
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE9D9;"
                             Content="Setup check"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Diagnostics}" />
                <RadioButton Style="{StaticResource NavItemStyle}"
                             GroupName="Nav"
                             Tag="&#xE946;"
                             Content="About"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=About}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="14,0,14,16">
                <Border Padding="14,12"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="7,0,0,0" FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Muted is stopped" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Text" Value="Muted is running" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Margin="14,3,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Your mic is unfiltered" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="Your mic is filtered" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RunSwitchStyle}"
                                    Command="{Binding ToggleCommand}"
                                    ToolTip="Start or stop RNNoise"
                                    AutomationProperties.Name="Start or stop RNNoise" />
                        </Grid>

                        <Button Margin="0,12,0,0"
                                Style="{StaticResource TextButtonStyle}"
                                Padding="10,8"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding ToggleMuteCommand}"
                                AutomationProperties.Name="Mute or unmute the microphone">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE720;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEffectivelyMuted}" Value="True">
                                                    <Setter Property="Text" Value="&#xE74F;" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding MuteStatusText}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================= Main column ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,12,0">
                <Button Style="{StaticResource ChromeButtonStyle}"
                        Content="&#xE744;"
                        Command="{Binding ToggleCompactCommand}"
                        ToolTip="Switch to the compact panel"
                        AutomationProperties.Name="Switch to the compact panel" />
                <Button Style="{StaticResource ChromeButtonStyle}"
                        Content="&#xE921;"
                        Click="MinimizeButton_OnClick"
                        ToolTip="Minimize"
                        AutomationProperties.Name="Minimize window" />
                <Button Style="{StaticResource ChromeButtonStyle}"
                        Content="&#xE922;"
                        Click="MaximizeButton_OnClick"
                        ToolTip="Maximize or restore"
                        AutomationProperties.Name="Maximize or restore window" />
                <Button Style="{StaticResource ChromeButtonStyle}"
                        Content="&#xE8BB;"
                        Click="CloseButton_OnClick"
                        ToolTip="Close"
                        AutomationProperties.Name="Close window" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="34,0,34,0">
                <Grid>
                    <views:DashboardView Style="{StaticResource PageStyle}"
                                         Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Dashboard}">
                        <views:DashboardView.RenderTransform>
                            <TranslateTransform />
                        </views:DashboardView.RenderTransform>
                    </views:DashboardView>

                    <views:AudioView Style="{StaticResource PageStyle}"
                                     Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Audio}">
                        <views:AudioView.RenderTransform>
                            <TranslateTransform />
                        </views:AudioView.RenderTransform>
                    </views:AudioView>

                    <views:ShortcutsView Style="{StaticResource PageStyle}"
                                         Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Shortcuts}">
                        <views:ShortcutsView.RenderTransform>
                            <TranslateTransform />
                        </views:ShortcutsView.RenderTransform>
                    </views:ShortcutsView>

                    <views:SettingsView Style="{StaticResource PageStyle}"
                                        Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Settings}">
                        <views:SettingsView.RenderTransform>
                            <TranslateTransform />
                        </views:SettingsView.RenderTransform>
                    </views:SettingsView>

                    <views:DiagnosticsView Style="{StaticResource PageStyle}"
                                           Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Diagnostics}">
                        <views:DiagnosticsView.RenderTransform>
                            <TranslateTransform />
                        </views:DiagnosticsView.RenderTransform>
                    </views:DiagnosticsView>

                    <views:AboutView Style="{StaticResource PageStyle}"
                                     Visibility="{Binding SelectedPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=About}">
                        <views:AboutView.RenderTransform>
                            <TranslateTransform />
                        </views:AboutView.RenderTransform>
                    </views:AboutView>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="34,10,34,16">
                <StackPanel Orientation="Horizontal">
                    <Path VerticalAlignment="Center"
                          Fill="{StaticResource TextMutedBrush}"
                          Data="M7,0 L14,2.6 V7 C14,11.4 11.2,13.8 7,15.4 C2.8,13.8 0,11.4 0,7 V2.6 Z M6.2,9.9 L3.9,7.6 L4.9,6.6 L6.2,7.9 L9.1,5 L10.1,6 Z" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="13"
                               Text="Local processing only" />
                    <TextBlock Margin="10,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="•" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="13"
                               Text="Your audio never leaves your PC" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="13"
                               Text="RNNoise" />
                    <Border Margin="10,0,0,0"
                            Padding="10,4"
                            CornerRadius="8"
                            Background="{StaticResource SuccessSurfaceBrush}">
                        <TextBlock x:Name="FooterVersionText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
