<Window x:Class="Muted.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Muted.App.Views"
        Title="Muted"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource BackgroundBrush}"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="0.985" ScaleY="0.985" />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Shell"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.32" />
                        <DoubleAnimation Storyboard.TargetName="ShellScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ShellScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1" Duration="0:0:0.45">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Rail ======================= -->
        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The word mark; LogoBrush, not AccentBrush, so the dot stays the brand colour. -->
            <TextBlock Grid.Row="0"
                       Margin="22,40,0,40"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="26"
                       FontWeight="Normal"
                       AutomationProperties.Name="Muted">
                <Run Text="muted" /><Run Text="." Foreground="{StaticResource LogoBrush}" FontWeight="Bold" />
            </TextBlock>

            <StackPanel Grid.Row="1" Margin="10,0,10,0">
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             Content="&#xE80F;"
                             ToolTip="Dashboard"
                             AutomationProperties.Name="Dashboard"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dashboard}" />
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             Content="&#xE720;"
                             ToolTip="Audio"
                             AutomationProperties.Name="Audio"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Audio}" />
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             ToolTip="Shortcuts"
                             AutomationProperties.Name="Shortcuts"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Shortcuts}">
                    <!-- Three sliders. -->
                    <Path Style="{StaticResource RailPathStyle}"
                          Data="M1,4 H21 M1,11 H21 M1,18 H21 M14,1.5 V6.5 M7,8.5 V13.5 M12,15.5 V20.5" />
                </RadioButton>
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             ToolTip="Presets and recording"
                             AutomationProperties.Name="Presets and recording"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Presets}">
                    <!-- Stacked layers. -->
                    <Path Style="{StaticResource RailPathStyle}"
                          Data="M11,1 L21,6 L11,11 L1,6 Z M1,11 L11,16 L21,11 M1,16 L11,21 L21,16" />
                </RadioButton>
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             ToolTip="Setup check"
                             AutomationProperties.Name="Setup check"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Diagnostics}">
                    <!-- Bar chart. -->
                    <Path Style="{StaticResource RailPathStyle}"
                          Data="M2,21 V10 M8,21 V3 M14,21 V8 M20,21 V13" />
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="10,0,10,26">
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             Content="&#xE946;"
                             ToolTip="About"
                             AutomationProperties.Name="About"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=About}" />
                <RadioButton Style="{StaticResource RailItemStyle}"
                             GroupName="Nav"
                             Margin="0"
                             Content="&#xE713;"
                             ToolTip="Settings"
                             AutomationProperties.Name="Settings"
                             IsChecked="{Binding SelectedPage, Converter={StaticResource EnumToBoolean}, ConverterParameter=Settings}" />
            </StackPanel>
        </Grid>

        <!-- ======================= Main column ======================= -->
        <Grid Grid.Column="1" Margin="34,0,34,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: microphone, running state, Advanced. -->
            <Grid Grid.Row="0" Margin="0,38,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="284">
                    <ComboBox MinHeight="48"
                              Padding="48,7,16,7"
                              FontSize="14"
                              ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInput}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CanSelectInput}"
                              ToolTip="Microphone. Stop processing to switch."
                              AutomationProperties.Name="Microphone input" />
                    <TextBlock Margin="18,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource TextBrush}"
                               Text="&#xE720;" />
                </Grid>

                <Button Grid.Column="2"
                        Margin="0,0,24,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusPillStyle}"
                        Command="{Binding ToggleCommand}"
                        ToolTip="Start or stop processing"
                        AutomationProperties.Name="Start or stop processing">
                    <StackPanel Orientation="Horizontal">
                        <Control Width="12" Height="12" Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="Stopped">
                                            <Setter Property="Text" Value="Start processing" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="Processing" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <ToggleButton x:Name="AdvancedToggle"
                              Grid.Column="3"
                              IsChecked="True"
                              Cursor="Hand"
                              ToolTip="Show or hide the advanced settings"
                              AutomationProperties.Name="Advanced settings">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="AdvancedSurface"
                                    MinHeight="48"
                                    Padding="18,0,16,0"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M1,3 H17 M1,9 H17 M1,15 H17 M12,0.5 V5.5 M5,6.5 V11.5 M10,12.5 V17.5"
                                          Stroke="{DynamicResource TextBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Margin="14,0,18,0"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="Advanced" />
                                    <Path x:Name="AdvancedChevron"
                                          Data="M0,0 L4.5,4.5 L0,9"
                                          Stroke="{DynamicResource TextBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ChevronTurn" Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AdvancedSurface" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                    <Setter TargetName="AdvancedSurface" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="AdvancedSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <!-- Points back towards the content while the panel is open. -->
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="AdvancedChevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                <Grid>
                    <views:DashboardView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Dashboard}" />

                    <views:AudioView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Audio}" />

                    <StackPanel Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Presets}">
                        <TextBlock Margin="0,14,0,4" Style="{StaticResource PageTitleStyle}" Text="Presets &amp; recording" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Voice presets, shared profiles, and a quick test recording." />
                        <views:FeaturesView Margin="0,4,0,24" />
                    </StackPanel>

                    <views:ShortcutsView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Shortcuts}" />

                    <views:SettingsView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Settings}" />

                    <views:DiagnosticsView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=Diagnostics}" />

                    <views:AboutView Visibility="{Binding SelectedPage,
                                              Converter={StaticResource EnumToVisibility},
                                              ConverterParameter=About}" />
                </Grid>
            </ScrollViewer>

            <!-- Status bar -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource BorderBrush}" />
                <Grid Margin="0,22,0,26">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding HealthText}">
                        <Control Width="12" Height="12" Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="Engine healthy" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRecovering}" Value="True">
                                            <Setter Property="Text" Value="Reconnecting…" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" />
                        <!-- The engine always runs at 48 kHz mono; RNNoise only works that way. -->
                        <TextBlock Style="{StaticResource StatusTextStyle}" Text="48 kHz  ·  Mono  ·  RNNoise" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                   ToolTip="How much of each audio frame the processing thread needs"
                                   Text="{Binding ProcessingLoadText}" />
                        <Rectangle Style="{StaticResource StatusSeparatorStyle}" />
                        <TextBlock Style="{StaticResource StatusTextStyle}"
                                   ToolTip="Audio currently waiting in the output buffer"
                                   Text="{Binding BufferText}" />
                        <Button Margin="18,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE70E;"
                                Command="{Binding ToggleCompactCommand}"
                                ToolTip="Switch to the compact panel"
                                AutomationProperties.Name="Switch to the compact panel" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ======================= Advanced panel ======================= -->
        <Border Grid.Column="2"
                Width="312"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="0,54,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="24,8,16,18">
                    <TextBlock FontSize="18" VerticalAlignment="Center" Text="Advanced settings" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButtonStyle}"
                            FontSize="14"
                            Foreground="{DynamicResource TextBrush}"
                            Content="&#xE8BB;"
                            Click="CloseAdvanced_OnClick"
                            ToolTip="Close"
                            AutomationProperties.Name="Close advanced settings" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <views:AdvancedPanel Margin="24,0,22,24" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Window buttons sit above everything, at the top right. -->
        <StackPanel Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,10,0">
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE921;"
                    Click="MinimizeButton_OnClick"
                    ToolTip="Minimize"
                    AutomationProperties.Name="Minimize window" />
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE922;"
                    Click="MaximizeButton_OnClick"
                    ToolTip="Maximize or restore"
                    AutomationProperties.Name="Maximize or restore window" />
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE8BB;"
                    Click="CloseButton_OnClick"
                    ToolTip="Close"
                    AutomationProperties.Name="Close window" />
        </StackPanel>
    </Grid>
</Window>
