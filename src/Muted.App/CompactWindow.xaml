<Window x:Class="Muted.App.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Muted.App.Controls"
        Title="Muted"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Panel"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
            Opacity="0"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelShift" Y="14" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Panel"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.26" />
                        <DoubleAnimation Storyboard.TargetName="PanelShift"
                                         Storyboard.TargetProperty="Y"
                                         To="0" Duration="0:0:0.4">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Control Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" />
                    <TextBlock Margin="9,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="30" Height="26"
                            Padding="0"
                            Style="{StaticResource TextButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Content="&#xE740;"
                            Command="{Binding ToggleCompactCommand}"
                            ToolTip="Back to the full window"
                            AutomationProperties.Name="Back to the full window"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Width="30" Height="26"
                            Padding="0"
                            Style="{StaticResource TextButtonStyle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Content="&#xE921;"
                            Click="HideButton_OnClick"
                            ToolTip="Hide to the tray"
                            AutomationProperties.Name="Hide to the tray"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <controls:LiveWaveform Height="46"
                                   Margin="0,12,0,0"
                                   Scope="{Binding Scope}"
                                   IsActive="{Binding IsRunning}"
                                   VoiceProbability="{Binding VoiceProbability}" />

            <controls:LevelMeter Height="8"
                                 Margin="0,10,0,0"
                                 Level="{Binding InputLevel, Mode=OneWay}"
                                 AutomationProperties.Name="Input level meter" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="10,8"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding ToggleMuteCommand}"
                        AutomationProperties.Name="Mute or unmute the microphone">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE720;" />
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEffectivelyMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;" />
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="9,0,0,0"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="{Binding MuteStatusText}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="12,8"
                        Command="{Binding ToggleCommand}"
                        AutomationProperties.Name="Start or stop RNNoise">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="&#xE71A;" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
