<Window x:Class="Muted.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Muted update"
        Icon="pack://siteoforigin:,,,/icon.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource BackgroundBrush}"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Panel"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22,20,22,20"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelShift" Y="10" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Panel"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.22" />
                        <DoubleAnimation Storyboard.TargetName="PanelShift"
                                         Storyboard.TargetProperty="Y"
                                         To="0" Duration="0:0:0.36">
                            <DoubleAnimation.EasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <StackPanel>
            <!-- Header: badge, title, version line and a close button. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Badge"
                        Width="44" Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="BadgeGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="&#xE896;" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,1,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="19"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="Update available" />
                    <TextBlock x:Name="SubtitleText"
                               Margin="0,3,0,0"
                               Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="30" Height="28"
                        Padding="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource TextButtonStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Content="&#xE8BB;"
                        Click="CloseButton_OnClick"
                        ToolTip="Close"
                        AutomationProperties.Name="Close" />
            </Grid>

            <!-- Version comparison, only for an available update. -->
            <Border x:Name="VersionCard"
                    Margin="0,18,0,0"
                    Style="{StaticResource InsetCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Installed" />
                        <TextBlock x:Name="CurrentVersionText"
                                   Margin="0,2,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="&#xE72A;" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Right"
                                   Text="New" />
                        <TextBlock x:Name="NewVersionText"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Right"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText"
                       Margin="0,16,0,0"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />

            <TextBlock x:Name="ReleaseNotesLink"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Visibility="Collapsed">
                <Hyperlink Foreground="{DynamicResource AccentBrush}"
                           TextDecorations="{x:Null}"
                           Click="ReleaseNotes_OnClick">
                    <Run Text="See what's new" />
                    <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8A7;" />
                </Hyperlink>
            </TextBlock>

            <!-- Download progress, shown once installing starts. -->
            <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ProgressLabel"
                               Style="{StaticResource CaptionStyle}"
                               Text="Downloading…" />
                    <TextBlock x:Name="ProgressPercent"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionStyle}" />
                </Grid>
                <Border Margin="0,8,0,0"
                        Height="6"
                        CornerRadius="3"
                        Background="{DynamicResource MeterTrackBrush}"
                        ClipToBounds="True">
                    <Border x:Name="ProgressFill"
                            HorizontalAlignment="Left"
                            Width="0"
                            CornerRadius="3"
                            Background="{DynamicResource AccentBrush}" />
                </Border>
            </StackPanel>

            <!-- Buttons. -->
            <Grid x:Name="ButtonRow" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SkipButton"
                        Style="{StaticResource TextButtonStyle}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,8"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="12"
                        Content="Skip this version"
                        Click="SkipButton_OnClick" />

                <Button x:Name="LaterButton"
                        Grid.Column="2"
                        Style="{StaticResource TextButtonStyle}"
                        Padding="16,10"
                        Content="Later"
                        IsCancel="True"
                        Click="LaterButton_OnClick" />

                <Button x:Name="PrimaryButton"
                        Grid.Column="3"
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Click="PrimaryButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PrimaryGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="&#xE896;" />
                        <TextBlock x:Name="PrimaryText"
                                   VerticalAlignment="Center"
                                   Text="Install now" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
