<UserControl x:Class="Muted.App.Controls.InfoTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="18" Height="18" Margin="9,0,0,0"
             VerticalAlignment="Center"
             Focusable="True" IsTabStop="True" Cursor="Help"
             FocusVisualStyle="{DynamicResource FocusRing}"
             ToolTipService.InitialShowDelay="120"
             ToolTipService.BetweenShowDelay="0"
             ToolTipService.ShowDuration="60000"
             ToolTipService.ShowsToolTipOnKeyboardFocus="True">
    <UserControl.Resources>
        <Style x:Key="TipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,9,0,2"/>
        </Style>
        <Style x:Key="TipBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <UserControl.ToolTip>
        <ToolTip x:Name="Card" MaxWidth="320" Padding="14,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource TipLabel}" Text="WHAT IT DOES"/>
                <TextBlock Style="{StaticResource TipBody}" Text="{Binding What}"/>
                <TextBlock Style="{StaticResource TipLabel}" Text="BEST WHEN"/>
                <TextBlock Style="{StaticResource TipBody}" Text="{Binding Best}"/>
                <TextBlock Style="{StaticResource TipLabel}" Text="WHAT TO EXPECT"/>
                <TextBlock Style="{StaticResource TipBody}" Text="{Binding Expect}"/>
            </StackPanel>
        </ToolTip>
    </UserControl.ToolTip>

    <Border x:Name="Ring" Background="Transparent" BorderThickness="1" CornerRadius="9">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Opacity" Value="0.75"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="i" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"
                   Foreground="{Binding BorderBrush, ElementName=Ring}"/>
    </Border>
</UserControl>
