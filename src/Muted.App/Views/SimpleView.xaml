<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Muted.App.Infrastructure" xmlns:controls="clr-namespace:Muted.App.Controls" xmlns:views="clr-namespace:Muted.App.Views" x:Class="Muted.App.Views.SimpleView">
    <StackPanel Margin="12,48,12,12" HorizontalAlignment="Stretch">
        <Button x:Name="PowerButton" motion:Reveal.Delay="0" Command="{Binding ToggleCommand}" Width="158" Height="158" HorizontalAlignment="Center" Cursor="Hand" ToolTip="Start or stop microphone processing" AutomationProperties.Name="{Binding ProcessingActionText}">
            <!-- Keyboard focus: a round ring instead of the square default. -->
            <Button.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Ellipse Margin="-6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.FocusVisualStyle>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PowerScale"/>
                        </Grid.RenderTransform>
                        <!-- Two rings ripple outwards while Muted is cleaning your voice. -->
                        <Ellipse x:Name="Pulse1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Pulse1Scale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Pulse2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Pulse2Scale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Glow" Fill="{DynamicResource AccentSoftBrush}" Opacity="0"/>
                        <Ellipse x:Name="HoverTint" Fill="{DynamicResource TextBrush}" Opacity="0"/>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2"/>
                        <TextBlock x:Name="Power" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Power" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Breathing">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="Pulse1" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:2.4" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="Pulse1Scale" Storyboard.TargetProperty="ScaleX" From="1" To="1.35" Duration="0:0:2.4" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pulse1Scale" Storyboard.TargetProperty="ScaleY" From="1" To="1.35" Duration="0:0:2.4" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pulse2" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:2.4" BeginTime="0:0:1.2" RepeatBehavior="Forever"/>
                                        <DoubleAnimation Storyboard.TargetName="Pulse2Scale" Storyboard.TargetProperty="ScaleX" From="1" To="1.35" Duration="0:0:2.4" BeginTime="0:0:1.2" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Pulse2Scale" Storyboard.TargetProperty="ScaleY" From="1" To="1.35" Duration="0:0:2.4" BeginTime="0:0:1.2" RepeatBehavior="Forever"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Breathing"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.24"/>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.24"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PowerScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.8"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock motion:Reveal.Delay="50" Text="Your mic, clearer." FontSize="32" FontWeight="SemiBold" TextAlignment="Center" Margin="0,30,0,14"/>
        <StackPanel motion:Reveal.Delay="90" Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse Width="10" Height="10" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform/>
                </Ellipse.RenderTransform>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DotPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="0.8" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.8" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="DotPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ProcessingStatusText}" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TextBlock Text="{Binding MuteStatusText}" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsEffectivelyMuted, Converter={StaticResource BoolToVisibility}}"/>
        <controls:BarWaveform motion:Reveal.Delay="130" Scope="{Binding Scope}" IsActive="{Binding IsRunning}" Accent="{DynamicResource AccentBrush}" Idle="{DynamicResource TextMutedBrush}" Height="52" MaxWidth="330" Margin="32,30,32,28"/>
        <Border motion:Reveal.Delay="170" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="20,16" MaxWidth="460">
            <StackPanel>
                <TextBlock Text="Microphone" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInput}" AutomationProperties.Name="Microphone" ToolTip="Stop processing to change the microphone. System default can be enabled in Settings."/>
                <DockPanel Margin="0,14,0,0" ToolTip="{Binding StudioVoiceStatusText}">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding StudioVoice}" Style="{StaticResource ToggleStyle}" AutomationProperties.Name="Studio Voice"/>
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"><Run Text="Studio Voice"/><Run Text="  · noise and room echo" Foreground="{DynamicResource TextMutedBrush}"/></TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>
        <StackPanel Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
            <TextBlock Text="Choose a virtual cable output to send your clear voice to other apps." TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            <Button Content="Set up devices" Click="Settings_OnClick" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <Button motion:Reveal.Delay="210" Content="Test your voice" Click="Test_OnClick" HorizontalAlignment="Center" Style="{StaticResource TextButtonStyle}" Padding="28,12" Margin="0,24,0,0"/>
        <views:VoiceTestView x:Name="TestArea" Visibility="Collapsed" Margin="0,16,0,0"/>
        <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource DangerSurfaceBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                <Button Content="Choose devices in Settings" Click="Settings_OnClick" Style="{StaticResource TextButtonStyle}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
