<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Muted.App.Infrastructure" xmlns:controls="clr-namespace:Muted.App.Controls" xmlns:views="clr-namespace:Muted.App.Views" x:Class="Muted.App.Views.SimpleView" motion:Reveal.Delay="0">
    <StackPanel Margin="12,48,12,12" HorizontalAlignment="Stretch">
        <Button x:Name="PowerButton" Command="{Binding ToggleCommand}" Width="158" Height="158" HorizontalAlignment="Center" ToolTip="Start or stop microphone processing" AutomationProperties.Name="{Binding ProcessingActionText}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Ring" CornerRadius="90" BorderThickness="2" BorderBrush="{DynamicResource BorderStrongBrush}" Background="Transparent">
                        <TextBlock x:Name="Power" Text="" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Power" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderThickness" Value="4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock Text="Your mic, clearer." FontSize="36" FontWeight="Light" TextAlignment="Center" Margin="0,30,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ProcessingStatusText}" FontSize="18" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TextBlock Text="{Binding MuteStatusText}" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsEffectivelyMuted, Converter={StaticResource BoolToVisibility}}"/>
        <controls:BarWaveform Scope="{Binding Scope}" IsActive="{Binding IsRunning}" Accent="{DynamicResource AccentBrush}" Idle="{DynamicResource TextMutedBrush}" Height="52" MaxWidth="330" Margin="32,30,32,28"/>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,14" MaxWidth="460">
            <StackPanel>
                <TextBlock Text="Microphone" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInput}" AutomationProperties.Name="Microphone" ToolTip="Stop processing to change the microphone. System default can be enabled in Settings."/>
            </StackPanel>
        </Border>
        <StackPanel Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
            <TextBlock Text="Choose a virtual cable output to send your clear voice to other apps." TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            <Button Content="Set up devices" Click="Settings_OnClick" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <Button Content="Test your voice" Click="Test_OnClick" HorizontalAlignment="Center" Style="{StaticResource TextButtonStyle}" Padding="28,12" Margin="0,24,0,0"/>
        <views:VoiceTestView x:Name="TestArea" Visibility="Collapsed" Margin="0,16,0,0"/>
        <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource DangerSurfaceBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                <Button Content="Choose devices in Settings" Click="Settings_OnClick" Style="{StaticResource TextButtonStyle}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
