<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Muted.App.Infrastructure" xmlns:views="clr-namespace:Muted.App.Views" x:Class="Muted.App.Views.AdvancedView" motion:Reveal.Delay="0">
    <UserControl.Resources>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" CornerRadius="8" Background="Transparent" Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="4,16,4,8">
        <TextBlock Text="Advanced settings" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Fine-tune what matters. Muted handles the rest." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,18"/>
        <Border Style="{StaticResource Group}" motion:Reveal.Delay="30">
            <StackPanel>
                <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Microphone" VerticalAlignment="Center" Margin="0,0,12,12"/>
                    <ComboBox Grid.Column="1" Margin="0,0,0,12" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInput}" AutomationProperties.Name="Microphone input"/>
                    <TextBlock Grid.Row="1" Text="Cable output" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsStopped}" AutomationProperties.Name="Processed output"/>
                </Grid>
                <TextBlock Text="Stop processing to change devices. Rescan devices in Settings if needed." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"/>
                <TextBlock Text="A virtual cable is needed to send your processed voice to other apps." TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Group}" motion:Reveal.Delay="65">
            <StackPanel>
                <TextBlock Text="Sound" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutoTuneEnabled}" Style="{StaticResource ToggleStyle}" AutomationProperties.Name="Automatic tuning"/>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Automatic tuning" FontSize="15"/>
                        <TextBlock Text="Adapts microphone boost and the voice gate as you speak." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>
                <TextBlock Text="Noise removal" FontSize="15" Margin="0,0,0,10"/>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="9">
                    <Grid x:Name="NoiseTrack" SizeChanged="NoiseTrack_OnSizeChanged">
                        <Border x:Name="NoiseIndicator" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="8">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NoiseShift"/>
                            </Border.RenderTransform>
                        </Border>
                        <UniformGrid Columns="3">
                            <RadioButton Content="Gentle" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Gentle}"/>
                            <RadioButton Content="Balanced" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Balanced}"/>
                            <RadioButton Content="Strong" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Strong}"/>
                        </UniformGrid>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding NoiseRemovalDescription}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VoiceLevelText}"/>
                    <TextBlock Text="Voice level" FontSize="15"/>
                </DockPanel>
                <Slider Minimum="-12.05" Maximum="12.05" SmallChange="1" LargeChange="3" Value="{Binding VoiceLevelDb}" AutomationProperties.Name="Voice level in decibels" Margin="0,12,0,8"/>
                <TextBlock Text="Output adjustment after automatic level handling." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,12"/>
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EchoCancellationEnabled}" Style="{StaticResource ToggleStyle}" AutomationProperties.Name="Echo cancellation"/>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Echo cancellation" FontSize="15"/>
                        <TextBlock Text="Useful when using speakers." Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Visibility="{Binding EchoCancellationEnabled, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                    <TextBlock Text="Speaker reference" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedEchoReference}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsStopped}" AutomationProperties.Name="Echo cancellation speaker reference"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Group}">
            <views:VoiceTestView/>
        </Border>
        <Expander Header="Technical controls" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,16">
            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="Existing detailed controls and tools. These can change the sound beyond the choices above." TextWrapping="Wrap" Margin="0,0,0,16"/>
                <views:AdvancedPanel/>
                <Expander Header="Full processing chain and calibration" Margin="0,20,0,0">
                    <views:AudioView/>
                </Expander>
                <Expander Header="Profiles, recording export and other tools" Margin="0,16,0,0">
                    <views:FeaturesView/>
                </Expander>
                <Expander Header="Keyboard shortcuts" Margin="0,16,0,0">
                    <views:ShortcutsView/>
                </Expander>
            </StackPanel>
        </Expander>
        <Button Command="{Binding ToggleCommand}" Content="{Binding ProcessingActionText}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right"/>
    </StackPanel>
</UserControl>
