<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:Muted.App.Infrastructure"
             xmlns:views="clr-namespace:Muted.App.Views"
             xmlns:controls="clr-namespace:Muted.App.Controls"
             x:Class="Muted.App.Views.AdvancedView"
             motion:Reveal.Delay="0">
    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" CornerRadius="8" Background="Transparent" Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Everything about how you sound. A menu on the left, one section at a time on the
         right; the menu stays put while the section scrolls. App preferences such as
         devices, startup and updates live under Settings, not here. -->
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <!-- Whether Muted is on, quietly, with a way to switch it. Home has the big button. -->
            <StackPanel x:Name="StatusLine" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="14,12,0,4">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ProcessingStatusText}" Style="{StaticResource CaptionStyle}" Margin="8,0,10,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource LinkButtonStyle}" Content="{Binding ProcessingShortAction}" Command="{Binding ToggleCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding ProcessingActionText}"/>
            </StackPanel>
            <StackPanel x:Name="Menu">
                <TextBlock x:Name="MenuTitle" Text="Your sound" Style="{StaticResource MenuGroupTitle}" Margin="14,4,0,8"/>
                <RadioButton x:Name="SoundNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Sound" Tag="&#xE767;" Checked="Menu_OnChecked" AutomationProperties.Name="Sound"/>
                <RadioButton x:Name="VoiceNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Your voice" Tag="&#xE720;" Checked="Menu_OnChecked" AutomationProperties.Name="Your voice"/>
                <RadioButton x:Name="ChainNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Processing" Tag="&#xE9E9;" Checked="Menu_OnChecked" AutomationProperties.Name="Processing chain"/>
                <TextBlock x:Name="MoreTitle" Text="Tools" Style="{StaticResource MenuGroupTitle}" Margin="14,18,0,8"/>
                <RadioButton x:Name="TestNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Voice test" Tag="&#xE768;" Checked="Menu_OnChecked" AutomationProperties.Name="Voice test"/>
                <RadioButton x:Name="ProfilesNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Profiles" Tag="&#xE8F1;" Checked="Menu_OnChecked" AutomationProperties.Name="Profiles"/>
                <RadioButton x:Name="HearNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="What you hear" Tag="&#xE7F6;" Checked="Menu_OnChecked" AutomationProperties.Name="Clean what you hear"/>
                <RadioButton x:Name="ShortcutsNav" GroupName="AdvancedMenu" Style="{StaticResource NavItemStyle}" Content="Shortcuts" Tag="&#xE765;" Checked="Menu_OnChecked" AutomationProperties.Name="Keyboard shortcuts"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">
            <Grid>
                <!-- ===================== Sound ===================== -->
                <StackPanel x:Name="SoundSection" motion:Reveal.Delay="0">
                    <TextBlock Text="Sound" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="How Muted cleans your voice and how loud you come across. Every other step is under Processing." Style="{StaticResource SectionIntroStyle}"/>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding StudioVoice}" Style="{StaticResource ToggleStyle}" AutomationProperties.Name="Studio Voice"/>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Studio Voice" Style="{StaticResource CardTitleStyle}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StudioVoiceStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StudioVoiceUnavailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <!-- The three models, only meaningful while Studio Voice is on. -->
                            <StackPanel Visibility="{Binding StudioVoice, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle Style="{StaticResource RowDividerStyle}"/>
                                <TextBlock Text="Model" Style="{StaticResource CaptionStyle}" Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9">
                                    <Grid x:Name="ModelTrack" SizeChanged="Track_OnSizeChanged" RadioButton.Checked="Track_OnChecked">
                                        <Border HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="8">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <UniformGrid Columns="3">
                                            <RadioButton Content="Classic" GroupName="StudioModel" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding StudioModel, Converter={StaticResource EnumToBoolean}, ConverterParameter=DeepFilterNet3}"
                                                         ToolTip="DeepFilterNet3 · lightest, and strong in quiet rooms"
                                                         AutomationProperties.Name="Classic, DeepFilterNet3"/>
                                            <RadioButton Content="Balanced" GroupName="StudioModel" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding StudioModel, Converter={StaticResource EnumToBoolean}, ConverterParameter=DpdfNet2}"
                                                         ToolTip="DPDFNet 2 · also removes noise that sits in the same band as your voice"
                                                         AutomationProperties.Name="Balanced, DPDFNet 2"/>
                                            <RadioButton Content="Maximum" GroupName="StudioModel" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding StudioModel, Converter={StaticResource EnumToBoolean}, ConverterParameter=DpdfNet8}"
                                                         ToolTip="DPDFNet 8 · strongest, keeps the most detail, uses the most processor"
                                                         AutomationProperties.Name="Maximum quality, DPDFNet 8"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding StudioModelSummary}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0"/>
                                <StackPanel Visibility="{Binding StudioModel, Converter={StaticResource EnumToVisibility}, ConverterParameter=DpdfNet8}">
                                    <Rectangle Style="{StaticResource RowDividerStyle}"/>
                                    <controls:SettingRow Title="Step down when the PC is busy"
                                                         Description="Maximum crackles when a heavy game takes the processor. Balanced then cleans until there is room again.">
                                        <CheckBox IsChecked="{Binding StudioAutoStepDown}" Style="{StaticResource ToggleStyle}" AutomationProperties.Name="Step down when the PC is busy"/>
                                    </controls:SettingRow>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Visibility="{Binding StudioVoice, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Noise removal" Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="With the standard noise removal: how much of the room is taken out." Style="{StaticResource SettingsCardIntroStyle}"/>
                            <Border Margin="0,12,0,0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="9">
                                <Grid x:Name="NoiseTrack" SizeChanged="Track_OnSizeChanged" RadioButton.Checked="Track_OnChecked">
                                    <Border HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="8">
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="Gentle" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Gentle}"/>
                                        <RadioButton Content="Balanced" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Balanced}"/>
                                        <RadioButton Content="Strong" GroupName="Noise" Style="{StaticResource Segment}" IsChecked="{Binding NoiseRemoval, Converter={StaticResource EnumToBoolean}, ConverterParameter=Strong}"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding NoiseRemovalDescription}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Expander Header="Fine-tune" Margin="0,14,0,0">
                                <controls:SettingRow Margin="0,12,0,0"
                                                     Title="Strength"
                                                     Stacked="True"
                                                     ValueText="{Binding WetMixText}"
                                                     IsEnabled="{Binding CanAdjustNoiseBlend}"
                                                     TipWhat="How much cleaned sound is used. 100% is fully cleaned; lower values mix some of your untouched microphone back in."
                                                     TipBest="Keep it at 100% in a noisy room. Lower it if your voice sounds thin or robotic."
                                                     TipExpect="Lower values let more of the room through. Gentle, Balanced and Strong are 45%, 80% and 100%.">
                                    <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding WetMix}" AutomationProperties.Name="Noise reduction strength"/>
                                </controls:SettingRow>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <controls:SettingRow Title="Voice level"
                                             Stacked="True"
                                             ValueText="{Binding VoiceLevelText}"
                                             Description="How loud your voice leaves Muted, after the noise removal. Raise it when people say you are quiet."
                                             TipWhat="Makes your voice louder or softer after the noise removal, just before it leaves Muted."
                                             TipBest="+3 to +6 dB is usually enough for a quiet voice."
                                             TipExpect="The leftover noise gets louder by the same amount, but the limiter still catches peaks. With Automatic level on, it trims what Automatic level sets.">
                            <Slider Minimum="-12.05" Maximum="12.05" SmallChange="1" LargeChange="3" Value="{Binding VoiceLevelDb}" AutomationProperties.Name="Voice level in decibels"/>
                        </controls:SettingRow>
                    </Border>
                </StackPanel>

                <!-- ===================== Your voice ===================== -->
                <StackPanel x:Name="VoiceSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Your voice" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Let Muted measure your voice and set everything for you, and learn how you sound." Style="{StaticResource SectionIntroStyle}"/>
                    <views:VoiceTuningView/>
                </StackPanel>

                <!-- ===================== Processing ===================== -->
                <StackPanel x:Name="ChainSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Processing" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Every step of the sound chain, in the order your voice goes through it. Most microphones only need the defaults." Style="{StaticResource SectionIntroStyle}"/>
                    <views:ProcessingView/>
                </StackPanel>

                <!-- ===================== Voice test ===================== -->
                <StackPanel x:Name="TestSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Voice test" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Record a few seconds and hear what others hear, or listen to yourself live." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <views:VoiceTestView ShowTitle="False"/>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <controls:SettingRow Title="Hear yourself"
                                                 Description="Plays the processed voice on the playback device above as well, so you hear exactly what the other side gets.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding MonitorEnabled}" AutomationProperties.Name="Hear yourself"/>
                            </controls:SettingRow>
                            <StackPanel Visibility="{Binding MonitorEnabled, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle Style="{StaticResource RowDividerStyle}"/>
                                <controls:SettingRow Title="Volume" Stacked="True" ValueText="{Binding MonitorVolumeText}">
                                    <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding MonitorVolume}" AutomationProperties.Name="Hear yourself volume"/>
                                </controls:SettingRow>
                                <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="10"
                                        Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                        Visibility="{Binding MonitorFeedbackWarning, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap"
                                               Text="Hearing yourself on speakers feeds the room back into your microphone. Use headphones, or leave echo cancellation on."/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Profiles ===================== -->
                <StackPanel x:Name="ProfilesSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Profiles" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Presets, your saved setups, and switching between them by themselves." Style="{StaticResource SectionIntroStyle}"/>
                    <views:ProfilesView/>
                </StackPanel>

                <!-- ===================== Clean what you hear ===================== -->
                <StackPanel x:Name="HearSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Clean what you hear" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Removes the noise in other people's audio too: their fans, keyboards and traffic. Runs separately from your microphone." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
                        <StackPanel>
                            <controls:SettingRow Title="Clean what you hear"
                                                 Description="Set your call app's output to a second virtual cable, such as VB-CABLE A+B or Voicemeeter, and pick that cable's recording side below. Muted plays the cleaned sound on your headphones.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding ListeningEnabled}" AutomationProperties.Name="Clean what you hear"/>
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}"/>
                            <controls:SettingRow Title="Listen to" Description="The recording side of the cable your call app plays into." Stacked="True">
                                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding ListeningInput}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Device to clean"/>
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}"/>
                            <controls:SettingRow Title="Play on" Description="Headphones recommended." Stacked="True">
                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding ListeningOutput}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Device to play the cleaned sound on"/>
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}"/>
                            <controls:SettingRow Title="Strength" Stacked="True" ValueText="{Binding ListeningStrengthText}">
                                <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding ListeningStrength}" AutomationProperties.Name="How much of what you hear is cleaned"/>
                            </controls:SettingRow>
                            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="{Binding ListeningStatus}" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding ListeningReductionText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Shortcuts ===================== -->
                <StackPanel x:Name="ShortcutsSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Work anywhere in Windows, even in a full-screen game." Style="{StaticResource SectionIntroStyle}"/>
                    <views:ShortcutsView ShowHeader="False"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
