<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:Muted.App.Infrastructure"
             xmlns:views="clr-namespace:Muted.App.Views"
             xmlns:controls="clr-namespace:Muted.App.Controls"
             x:Class="Muted.App.Views.EverydaySettingsView"
             motion:Reveal.Delay="0">
    <!-- Everything about the app itself, laid out like Advanced: a menu on the left and
         one section at a time on the right. How you sound lives under Advanced. -->
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Menu" Margin="0,0,16,0">
            <TextBlock x:Name="MenuTitle" Text="Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="14,4,0,8"/>
                <RadioButton x:Name="DevicesNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Devices" Tag="&#xE772;" Checked="Menu_OnChecked" AutomationProperties.Name="Devices"/>
                <RadioButton x:Name="StartupNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Startup" Tag="&#xE7E8;" Checked="Menu_OnChecked" AutomationProperties.Name="Startup and window"/>
                <RadioButton x:Name="IndicatorsNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Indicators" Tag="&#xEA8F;" Checked="Menu_OnChecked" AutomationProperties.Name="Indicators and sounds"/>
                <RadioButton x:Name="AppearanceNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Appearance" Tag="&#xE790;" Checked="Menu_OnChecked" AutomationProperties.Name="Appearance"/>
                <RadioButton x:Name="UpdatesNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Updates" Tag="&#xE895;" Checked="Menu_OnChecked" AutomationProperties.Name="Updates"/>
                <RadioButton x:Name="HelpNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="Help" Tag="&#xE897;" Checked="Menu_OnChecked" AutomationProperties.Name="Help"/>
                <RadioButton x:Name="AboutNav" GroupName="SettingsMenu" Style="{StaticResource NavItemStyle}" Content="About" Tag="&#xE946;" Checked="Menu_OnChecked" AutomationProperties.Name="About Muted"/>
        </StackPanel>

        <ScrollViewer x:Name="SectionScroll" Grid.Column="1" VerticalScrollBarVisibility="Visible" Padding="0,0,8,0">
            <Grid>
                <!-- ===================== Devices ===================== -->
                <StackPanel x:Name="DevicesSection" motion:Reveal.Delay="0">
                    <TextBlock Text="Devices" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Your microphone and the virtual cable your voice goes out on. Stop processing to change them." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <controls:SettingRow Title="Microphone" Stacked="True">
                                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInput}" AutomationProperties.Name="Microphone" />
                            </controls:SettingRow>
                            <controls:SettingRow Margin="0,14,0,0" Title="Follow the Windows default microphone"
                                                 Description="Switches along whenever Windows changes its default input.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding FollowDefaultInput}" AutomationProperties.Name="Follow the Windows default microphone" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Cable output"
                                                 Description="Your virtual cable. In your call app, choose the cable's recording side as the microphone."
                                                 Stacked="True">
                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsStopped}" AutomationProperties.Name="Virtual cable output" />
                            </controls:SettingRow>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                       Text="A virtual cable is needed to send your clear voice to other apps."
                                       Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding ErrorMessage}"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Rescan devices" Command="{Binding RescanDevicesCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Get a virtual cable" Command="{Binding OpenCableDownloadCommand}" Style="{StaticResource TextButtonStyle}"
                                        Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Reconnect automatically"
                                                 Description="If a device disappears mid-call, keep retrying until it comes back instead of staying silent.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding AutoRecoverDevices}" AutomationProperties.Name="Reconnect automatically" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== Startup and window ===================== -->
                <StackPanel x:Name="StartupSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Startup and window" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="How Muted starts and where it goes when you close it." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <controls:SettingRow Title="Start with Windows" Description="Launch Muted automatically when you sign in.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Start minimized" Description="Open in the tray instead of showing the window.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start minimized" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Start muted" Description="Begin every session with the microphone muted.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding StartMuted}" AutomationProperties.Name="Start muted" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Minimize to tray" Description="Keep filtering in the background when the window closes.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding MinimizeToTray}" AutomationProperties.Name="Minimize to tray" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Compact window" Description="A small always-on-top panel with just the meter and a mute button.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding CompactMode}" AutomationProperties.Name="Compact window" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== Indicators and sounds ===================== -->
                <StackPanel x:Name="IndicatorsSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Indicators and sounds" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="How Muted shows that it hears you, and when it warns you." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <controls:SettingRow Title="In-game indicator"
                                                 Description="A small Live or Muted pill on top of every window while audio runs. Clicks go through it. Games in exclusive full-screen draw over it; borderless or windowed mode shows it.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding OverlayEnabled}" AutomationProperties.Name="In-game indicator" />
                            </controls:SettingRow>
                            <controls:SettingRow Margin="0,12,0,0" Title="Position" Visibility="{Binding OverlayEnabled, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox MinWidth="160" ItemsSource="{Binding OverlayPositions}" SelectedItem="{Binding OverlayPosition}" AutomationProperties.Name="Indicator position" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Speaking activity in the tray" Description="The tray icon lights up while you talk.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding SpeakingTrayEnabled}" AutomationProperties.Name="Show speaking activity in the tray" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Muted reminder" Description="A notice when you talk while you muted yourself.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding MuteReminderEnabled}" AutomationProperties.Name="Remind me when I speak while muted" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Push-to-talk sounds" Description="A short click when push to talk opens and closes, on the voice test playback device.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding PushToTalkSoundsEnabled}" AutomationProperties.Name="Play push-to-talk sounds" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Performance warnings" Description="A notice when the processing falls behind or the audio drops out.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding HealthWarningsEnabled}" AutomationProperties.Name="Warn about processing load and dropouts" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== Appearance ===================== -->
                <StackPanel x:Name="AppearanceSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Theme and colours." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <controls:SettingRow Title="Theme" Description="Follow Windows switches the moment Windows does." Stacked="True">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="Follow Windows" Margin="0,0,8,0"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=System}" AutomationProperties.Name="Follow the Windows theme" />
                                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="Dark" Margin="0,0,8,0"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dark}" AutomationProperties.Name="Dark theme" />
                                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="Light"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Light}" AutomationProperties.Name="Light theme" />
                                </StackPanel>
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Use the Windows accent colour" Description="Replaces Muted's violet with the highlight colour you picked in Windows.">
                                <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding UseSystemAccentColor}" AutomationProperties.Name="Use the Windows accent colour" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== Updates ===================== -->
                <StackPanel x:Name="UpdatesSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="New versions of Muted, straight from GitHub." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <controls:SettingRow Title="Software updates" Description="{Binding UpdateStatusText}">
                                <Button Style="{StaticResource TextButtonStyle}" Command="{Binding CheckForUpdatesCommand}" Content="Check for updates" AutomationProperties.Name="Check for updates" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Channel"
                                                 Description="Beta also offers prereleases. Installed copies update themselves; portable ZIP copies do not."
                                                 Stacked="True">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="Channel" Content="Stable" Margin="0,0,8,0"
                                                 IsChecked="{Binding UpdateChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter=Stable}" AutomationProperties.Name="Stable update channel" />
                                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="Channel" Content="Beta"
                                                 IsChecked="{Binding UpdateChannel, Converter={StaticResource EnumToBoolean}, ConverterParameter=Beta}" AutomationProperties.Name="Beta update channel" />
                                </StackPanel>
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== Help ===================== -->
                <StackPanel x:Name="HelpSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="Help" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Setting up your call apps, checking your setup, and starting over." Style="{StaticResource SectionIntroStyle}"/>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Expander Header="Set up your call apps" IsExpanded="{Binding ShowSetupGuide, Mode=OneWay}">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="1. Install a virtual cable" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SetupCableText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="2. Microphone in, cable out" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SetupRoutingText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="3. Switch Muted on" FontWeight="SemiBold" />
                                    <TextBlock Text="Use the power button on the home screen, then record a voice test." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="4. Select the cable in your call app" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SetupCallAppText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <Button Content="Finish setup" Command="{Binding FinishSetupCommand}" Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Check setup" Description="Tests your microphone, cable, Windows format and live signal, and helps you report a problem.">
                                <Button Style="{StaticResource TextButtonStyle}" Content="Open" Click="Diagnostics_OnClick" AutomationProperties.Name="Open the setup check" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Settings and logs" Description="settings.json and Muted.log live in your local app data folder.">
                                <Button Style="{StaticResource TextButtonStyle}" Command="{Binding OpenLogFolderCommand}" Content="Open folder" AutomationProperties.Name="Open the Muted data folder" />
                            </controls:SettingRow>
                            <Rectangle Style="{StaticResource RowDividerStyle}" />
                            <controls:SettingRow Title="Reset everything" Description="Puts every setting, profile and shortcut back to its default.">
                                <Button Style="{StaticResource TextButtonStyle}" Command="{Binding ResetSettingsCommand}" Content="Reset" AutomationProperties.Name="Reset all settings" />
                            </controls:SettingRow>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- ===================== About ===================== -->
                <StackPanel x:Name="AboutSection" motion:Reveal.Delay="0" Visibility="Collapsed">
                    <TextBlock Text="About" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="The version you run, and who made what." Style="{StaticResource SectionIntroStyle}"/>
                    <views:AboutView/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
