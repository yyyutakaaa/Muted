<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:Muted.App.Infrastructure" xmlns:views="clr-namespace:Muted.App.Views" x:Class="Muted.App.Views.EverydaySettingsView" motion:Reveal.Delay="0">
    <StackPanel Margin="4,24,4,8">
        <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,24"/>
        <Border Style="{StaticResource CardStyle}" Padding="22">
            <StackPanel>
                <TextBlock Text="Simple is your home screen. Open Advanced beside Settings whenever you want more audio controls." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Microphone" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <DockPanel Margin="0,0,0,12">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="{Binding FollowDefaultInput}" AutomationProperties.Name="Follow the Windows default microphone"/>
                    <TextBlock Text="Follow the Windows default microphone" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInput}" AutomationProperties.Name="Microphone"/>
                <TextBlock Text="Stop processing to choose a different microphone." Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                <TextBlock Text="Processed output" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsStopped}" AutomationProperties.Name="Virtual cable output"/>
                <TextBlock Text="Choose your virtual cable. In your call app, select the cable's recording device as the microphone." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                <Button Content="Rescan devices" Command="{Binding RescanDevicesCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                <Button Content="Get a virtual cable" Command="{Binding OpenCableDownloadCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="{Binding NeedsVirtualCableSetup, Converter={StaticResource BoolToVisibility}}"/>
                <DockPanel Margin="0,24,0,12">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows"/>
                    <TextBlock Text="Start with Windows" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
                <DockPanel Margin="0">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleStyle}" IsChecked="{Binding AutoRecoverDevices}" AutomationProperties.Name="Reconnect when devices return"/>
                    <TextBlock Text="Reconnect when devices return" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Choose how Muted looks." Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,14" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="System" IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=System}" AutomationProperties.Name="Follow Windows theme" Margin="0,0,8,0" />
                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dark}" AutomationProperties.Name="Dark theme" Margin="0,0,8,0" />
                    <RadioButton Style="{StaticResource PillRadioStyle}" GroupName="AppTheme" Content="Light" IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Light}" AutomationProperties.Name="Light theme" Margin="0,0,8,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Expander Header="Set up your call apps" IsExpanded="{Binding ShowSetupGuide, Mode=OneWay}" Margin="0,20,0,0" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="1. Install a virtual cable" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding SetupCableText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <TextBlock Text="2. Microphone in, cable out" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding SetupRoutingText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <TextBlock Text="3. Switch Muted on" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Use the power button on the home screen, then record a voice test." TextWrapping="Wrap" Margin="0,4,0,12"/>
                <TextBlock Text="4. Select the cable in your call app" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding SetupCallAppText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <WrapPanel>
                    <Button Content="Check setup" Command="{Binding ShowDiagnosticsCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,10,8"/>
                    <Button Content="Finish setup" Command="{Binding FinishSetupCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Expander>
        <Expander Header="More preferences and tools" Margin="0,20,0,20" Foreground="{DynamicResource TextMutedBrush}">
            <StackPanel Margin="0,16,0,0">
                <views:SettingsView/>
                <Button Content="Check audio setup" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource TextButtonStyle}" Click="Diagnostics_OnClick" Margin="0,16,0,0"/>
                <Expander Header="About Muted" Margin="0,16,0,0">
                    <views:AboutView/>
                </Expander>
            </StackPanel>
        </Expander>
        <Button Content="Done" Click="Done_OnClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="28,10"/>
    </StackPanel>
</UserControl>
