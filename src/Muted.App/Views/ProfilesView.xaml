<UserControl x:Class="Muted.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Muted.App.Controls"
             Foreground="{DynamicResource TextBrush}">
    <StackPanel>
        <!-- ===================== Presets ===================== -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Presets" />
                <TextBlock Style="{StaticResource SettingsCardIntroStyle}"
                           Text="A starting point for the whole chain. Natural keeps pauses open, Gaming uses a tighter gate, Podcast levels your voice, Meeting adds echo cancellation and Warm Radio gives a full, close-up voice. Applying one briefly restarts running audio." />
                <WrapPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource TextButtonStyle}" Content="Natural" Command="{Binding NaturalPresetCommand}" Margin="0,0,8,8" Padding="14,8" />
                    <Button Style="{StaticResource TextButtonStyle}" Content="Gaming" Command="{Binding GamingPresetCommand}" Margin="0,0,8,8" Padding="14,8" />
                    <Button Style="{StaticResource TextButtonStyle}" Content="Podcast" Command="{Binding PodcastPresetCommand}" Margin="0,0,8,8" Padding="14,8" />
                    <Button Style="{StaticResource TextButtonStyle}" Content="Meeting" Command="{Binding MeetingPresetCommand}" Margin="0,0,8,8" Padding="14,8" />
                    <Button Style="{StaticResource TextButtonStyle}" Content="Warm Radio" Command="{Binding WarmRadioPresetCommand}" Margin="0,0,8,8" Padding="14,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===================== Saved profiles ===================== -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Saved profiles" />
                <TextBlock Style="{StaticResource SettingsCardIntroStyle}"
                           Text="Your devices and the whole chain under one name. Pick one to apply it; the tray menu lists them too. An imported profile keeps your own microphone and cable." />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProfilePicker"
                              MinHeight="40"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProfilePicker_OnSelectionChanged"
                              AutomationProperties.Name="Saved audio profile" />
                    <Button x:Name="ProfileMenuButton"
                            Grid.Column="1"
                            Width="40" Height="40"
                            Margin="10,0,0,0"
                            Padding="0"
                            Style="{StaticResource TextButtonStyle}"
                            Click="ProfileMenuButton_OnClick"
                            ToolTip="More profile actions"
                            AutomationProperties.Name="More profile actions">
                        <!-- The icon font belongs on the glyph only. On the button it was inherited by the
                             menu that opens from it, which then drew every word as an empty box. -->
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Apply again" Command="{Binding ApplyProfileCommand}" />
                                <MenuItem Header="Update with current settings" Command="{Binding UpdateProfileCommand}" />
                                <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" />
                                <Separator />
                                <MenuItem Header="Import profiles…" Command="{Binding ImportProfilesCommand}" />
                                <MenuItem Header="Export selected…" Command="{Binding ExportSelectedProfileCommand}" />
                                <MenuItem Header="Export all…" Command="{Binding ExportProfilesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
                <Rectangle Style="{StaticResource RowDividerStyle}" />
                <controls:SettingRow Title="Save the current setup" Stacked="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox MaxLength="40" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New profile name" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource TextButtonStyle}" Padding="14,8" Command="{Binding SaveProfileCommand}" Content="Save" />
                    </Grid>
                </controls:SettingRow>
            </StackPanel>
        </Border>

        <!-- ===================== Automatic profiles ===================== -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <controls:SettingRow Title="Automatic profiles"
                                     Description="Switch to a profile while a program runs, like Gaming for your game and Meeting for Teams. When it closes, the profile you had before comes back. The first match in the list wins.">
                    <CheckBox Style="{StaticResource ToggleStyle}" IsChecked="{Binding AutoProfileEnabled}" AutomationProperties.Name="Automatic profiles" />
                </controls:SettingRow>
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding AutoProfileRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,0" Style="{StaticResource InsetCardStyle}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButtonStyle}" Content="Remove" Padding="10,4"
                                            Command="{Binding DataContext.RemoveAutoProfileRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Description}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding RunningPrograms}"
                              Text="{Binding NewRuleProcessName, UpdateSourceTrigger=PropertyChanged}"
                              DropDownOpened="RunningPrograms_OnDropDownOpened"
                              ToolTip="Type the program's name, like valorant or ms-teams, or open the list to pick one that is running."
                              AutomationProperties.Name="Program name" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding NewRuleProfile}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Profile to switch to" />
                    <Button Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource TextButtonStyle}" Content="Add" Padding="14,8" Command="{Binding AddAutoProfileRuleCommand}" />
                </Grid>
                <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Text="{Binding AutoProfileStatus}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
