<UserControl x:Class="Muted.App.Views.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Muted.App.Controls"
             Foreground="{StaticResource TextBrush}">
    <StackPanel>
        <StackPanel Margin="0,14,0,20">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Shortcuts" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource CaptionStyle}"
                       Text="Work anywhere in Windows, including inside a full-screen game. Muted never swallows the key, so it still reaches whatever you are using." />
        </StackPanel>

        <Border Style="{StaticResource CardStyle}" Padding="22">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Style="{StaticResource InsetCardStyle}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Hint}" />
                                    </StackPanel>

                                    <controls:HotkeyBox Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource HotkeyBoxStyle}"
                                                        VirtualKey="{Binding VirtualKey, Mode=TwoWay}"
                                                        Modifiers="{Binding Modifiers, Mode=TwoWay}"
                                                        ToolTip="Click, then press a key combination. Escape cancels, Backspace clears."
                                                        AutomationProperties.Name="{Binding Title}" />

                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextButtonStyle}"
                                            Padding="10,8"
                                            Command="{Binding DataContext.ClearHotkeyCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsAssigned}"
                                            ToolTip="Clear this shortcut"
                                            AutomationProperties.Name="Clear shortcut">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE711;" />
                                    </Button>

                                    <CheckBox Grid.Column="3"
                                              Margin="14,0,0,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleStyle}"
                                              IsChecked="{Binding Enabled}"
                                              IsEnabled="{Binding IsAssigned}"
                                              AutomationProperties.Name="Enable shortcut" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,8,0,0" Style="{StaticResource InsetCardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeysActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                    <Setter Property="Text" Value="No shortcut is assigned, so Muted is not listening for keys." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeysActive}" Value="True">
                                            <Setter Property="Text" Value="Listening for your shortcuts." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,24" Padding="22">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="How push to talk behaves" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource CaptionStyle}"
                           FontSize="13"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Text="Assign a push-to-talk key and Muted stays muted until you hold it. Clear the key and the microphone is live again by default. Push to mute is the opposite: live until you hold it. Both work while Muted is running, and both leave the key working in the app you are using." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
