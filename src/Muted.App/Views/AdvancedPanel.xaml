<UserControl x:Class="Muted.App.Views.AdvancedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="PanelComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="126" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,26" />
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="0,10,0,22" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===================== Preset ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PRESET" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfilePicker"
                      MinHeight="42"
                      FontSize="14"
                      ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProfilePicker_OnSelectionChanged"
                      ToolTip="Saved profiles. Picking one applies it."
                      AutomationProperties.Name="Saved audio profile" />
            <Button x:Name="ProfileMenuButton"
                    Grid.Column="1"
                    Width="42" Height="42"
                    Margin="10,0,0,0"
                    Padding="0"
                    Style="{StaticResource TextButtonStyle}"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Content="&#xE712;"
                    Click="ProfileMenuButton_OnClick"
                    ToolTip="More profile actions"
                    AutomationProperties.Name="More profile actions">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Apply again" Command="{Binding ApplyProfileCommand}" />
                        <MenuItem Header="Update with current settings" Command="{Binding UpdateProfileCommand}" />
                        <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" />
                        <Separator />
                        <MenuItem Header="Import profiles…" Command="{Binding ImportProfilesCommand}" />
                        <MenuItem Header="Export selected…" Command="{Binding ExportSelectedProfileCommand}" />
                        <MenuItem Header="Export all…" Command="{Binding ExportProfilesCommand}" />
                        <Separator />
                        <MenuItem Header="Save as new profile in Settings" Click="ManageProfiles_OnClick" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Rectangle Style="{StaticResource DividerStyle}" />

        <!-- ===================== Input & output ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="INPUT &amp; OUTPUT" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Input gain" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding InputGainText}" />
        </Grid>
        <Slider Minimum="0.25" Maximum="4"
                SmallChange="0.05" LargeChange="0.25"
                Value="{Binding InputGain}"
                AutomationProperties.Name="Input gain" />

        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Output gain" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding OutputGainText}" />
        </Grid>
        <Slider Margin="0,10,0,0"
                Minimum="0.25" Maximum="4"
                SmallChange="0.05" LargeChange="0.25"
                Value="{Binding OutputGain}"
                AutomationProperties.Name="Output gain" />

        <Rectangle Style="{StaticResource DividerStyle}" />

        <!-- ===================== Processing ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="PROCESSING" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="High-pass filter" />
            <ComboBox Style="{StaticResource PanelComboStyle}"
                      ItemsSource="{Binding HighPassChoices}"
                      SelectedItem="{Binding HighPassChoice}"
                      ToolTip="Cuts rumble below the speech band. Fine-tune it under Audio."
                      AutomationProperties.Name="High-pass filter" />
        </Grid>

        <Grid Margin="0,14,0,18">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Limiter" />
            <CheckBox HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding LimiterEnabled}"
                      AutomationProperties.Name="Limiter" />
        </Grid>

        <!-- RNNoise has no strength knob; this is the filtered/dry blend. -->
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Noise reduction strength" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding WetMix, StringFormat={}{0:0%}}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                IsEnabled="{Binding SuppressionEnabled}"
                Value="{Binding WetMix}"
                AutomationProperties.Name="Noise reduction strength" />

        <!-- The gate opens on RNNoise's voice probability, not on a dB level. -->
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Gate threshold" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding VoiceSensitivityText}" />
        </Grid>
        <Slider Minimum="0.05" Maximum="0.99"
                SmallChange="0.02" LargeChange="0.1"
                IsEnabled="{Binding VoiceGateEnabled}"
                Value="{Binding VoiceSensitivity}"
                ToolTip="How sure RNNoise must be that you are speaking before the gate opens"
                AutomationProperties.Name="Gate threshold" />

        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Gate hold time" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding VoiceHoldText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1000"
                SmallChange="10" LargeChange="50"
                TickFrequency="50"
                IsSnapToTickEnabled="True"
                IsEnabled="{Binding VoiceGateEnabled}"
                Value="{Binding VoiceHoldMilliseconds}"
                AutomationProperties.Name="Gate hold time" />

        <!-- Auto-tune: small, bounded steps on boost and gate while you talk. -->
        <Grid Margin="0,4,0,0">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Auto-tune" />
            <CheckBox HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding AutoTuneEnabled}"
                      ToolTip="Keeps adjusting the microphone boost and the voice gate while you talk, never far from where you started"
                      AutomationProperties.Name="Auto-tune" />
        </Grid>
        <TextBlock Margin="0,6,0,0"
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap"
                   Visibility="{Binding AutoTuneEnabled, Converter={StaticResource BoolToVisibility}}"
                   Text="{Binding AutoTuneStatusText}" />
        <Button Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource TextButtonStyle}"
                Padding="12,6"
                FontSize="13"
                Content="Tune to my voice…"
                Click="Calibrate_OnClick"
                ToolTip="Opens the guided calibration on the Audio page"
                AutomationProperties.Name="Tune to my voice" />

        <Rectangle Style="{StaticResource DividerStyle}" />

        <!-- ===================== Voice ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="VOICE" />
        <Grid Margin="0,0,0,18">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Warm radio voice" />
            <CheckBox HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding VoiceCharacterEnabled}"
                      ToolTip="A full, close-up and smooth sound"
                      AutomationProperties.Name="Warm radio voice" />
        </Grid>
        <StackPanel Visibility="{Binding VoiceCharacterEnabled, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Warmth" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding WarmthText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding Warmth}"
                AutomationProperties.Name="Voice warmth" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Proximity" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding ProximityText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding Proximity}"
                AutomationProperties.Name="Voice proximity" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Smoothness" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding SmoothnessText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding Smoothness}"
                AutomationProperties.Name="Voice smoothness" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Compression" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding CompressionText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding Compression}"
                AutomationProperties.Name="Voice compression" />
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Saturation" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding SaturationText}" />
        </Grid>
        <Slider Minimum="0" Maximum="1"
                SmallChange="0.05" LargeChange="0.1"
                Value="{Binding Saturation}"
                AutomationProperties.Name="Voice saturation" />
        </StackPanel>

        <Rectangle Style="{StaticResource DividerStyle}" Margin="0,8,0,26" />

        <!-- ===================== Shout guard ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SHOUT GUARD" />
        <Grid Margin="0,0,0,18">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Shout guard" />
            <CheckBox HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding ShoutGuardEnabled}"
                      ToolTip="Cuts the microphone the moment you get too loud"
                      AutomationProperties.Name="Shout guard" />
        </Grid>
        <StackPanel Visibility="{Binding ShoutGuardEnabled, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Loudness limit" />
                <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding ShoutThresholdText}" />
            </Grid>
            <Slider Minimum="-30" Maximum="0"
                    SmallChange="1" LargeChange="3"
                    Value="{Binding ShoutThresholdDb}"
                    ToolTip="Set this a few dB above your loudest normal speech"
                    AutomationProperties.Name="Shout guard loudness limit" />
            <Grid>
                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Turn down, don't silence" />
                <CheckBox HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Style="{StaticResource ToggleStyle}"
                          IsChecked="{Binding ShoutGuardDucks}"
                          ToolTip="Off: a shout is not heard at all. On: it comes through 20 dB quieter."
                          AutomationProperties.Name="Turn down instead of silence" />
            </Grid>
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Text="{Binding ShoutGuardStatusText}" />
        </StackPanel>

        <Rectangle Style="{StaticResource DividerStyle}" />

        <!-- ===================== Audio ===================== -->
        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="AUDIO" />

        <!-- Fixed by RNNoise, so these are read-outs rather than choices. -->
        <Grid>
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Sample rate" />
            <Border Width="126" MinHeight="38" HorizontalAlignment="Right" Style="{StaticResource InsetCardStyle}" Padding="12,0"
                    ToolTip="RNNoise always runs at 48 kHz">
                <TextBlock FontSize="14" VerticalAlignment="Center" Text="48 kHz" />
            </Border>
        </Grid>
        <Grid Margin="0,12,0,0">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Channels" />
            <Border Width="126" MinHeight="38" HorizontalAlignment="Right" Style="{StaticResource InsetCardStyle}" Padding="12,0"
                    ToolTip="Muted processes one voice channel">
                <TextBlock FontSize="14" VerticalAlignment="Center" Text="Mono" />
            </Border>
        </Grid>

        <TextBlock Margin="0,22,0,8" Style="{StaticResource RowLabelStyle}" Text="Virtual cable output" />
        <ComboBox ItemsSource="{Binding OutputDevices}"
                  SelectedItem="{Binding SelectedOutput}"
                  DisplayMemberPath="DisplayName"
                  IsEnabled="{Binding IsStopped}"
                  FontSize="13"
                  ToolTip="Where the filtered voice goes. Stop processing to switch."
                  AutomationProperties.Name="Virtual cable output" />

        <Grid Margin="0,22,0,0">
            <TextBlock Style="{StaticResource RowLabelStyle}" Text="Buffer size" />
            <TextBlock Style="{StaticResource RowValueStyle}" Text="{Binding LatencyText}" />
        </Grid>
        <Slider Margin="0,10,0,0"
                Minimum="20" Maximum="100"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                IsEnabled="{Binding IsStopped}"
                Value="{Binding TargetLatencyMilliseconds}"
                ToolTip="Lower is less delay, higher survives a busy PC. Change it while stopped."
                AutomationProperties.Name="Buffer size" />
    </StackPanel>
</UserControl>
