<UserControl x:Class="Muted.App.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Voice presets" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="Natural keeps pauses open. Gaming uses a tighter gate. Podcast levels your voice. Meeting adds echo cancellation. Warm Radio gives a full, close-up, smooth voice. Applying a preset briefly restarts running audio." />
                <WrapPanel>
                    <Button Content="Natural" Command="{Binding NaturalPresetCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Gaming" Command="{Binding GamingPresetCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Podcast" Command="{Binding PodcastPresetCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Meeting mode" Command="{Binding MeetingPresetCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Warm Radio" Command="{Binding WarmRadioPresetCommand}" Margin="0,0,8,8" Padding="12,8" />
                </WrapPanel>
                <TextBlock Margin="0,8" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Text="Share saved profiles. Applying an imported profile keeps your local microphone and cable selection." />
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Apply profile" Command="{Binding ApplyProfileCommand}" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Saved audio profile" />
                </DockPanel>
                <WrapPanel>
                    <Button Content="Import profiles…" Command="{Binding ImportProfilesCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Export selected…" Command="{Binding ExportSelectedProfileCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Export all…" Command="{Binding ExportProfilesCommand}" Margin="0,0,8,8" Padding="12,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Microphone test &amp; diagnosis" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,12" TextWrapping="Wrap"
                           Text="Start audio, press Record, and stop whenever you are finished. Recordings contain your processed output, including mute, and can last up to 2 minutes. They stay in memory until replaced, deleted, or the app closes. Saved WAV files remain on disk." />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,0,0,6" Text="Playback and push-to-talk sound output (headphones recommended)" />
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="Test playback output" Margin="0,0,0,12" />
                <WrapPanel>
                    <Button Content="{Binding RecordingButtonText}" Command="{Binding StartRecordingCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Stop recording" Command="{Binding StopRecordingCommand}" Margin="0,0,8,8" Padding="12,8" />
                </WrapPanel>
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="{Binding ClipDuration}" Value="{Binding ClipPosition}"
                            IsMoveToPointEnabled="True" AutomationProperties.Name="Recording playback position" />
                    <TextBlock Grid.Column="1" Text="{Binding ClipTimeText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <WrapPanel>
                    <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseClipCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Rewind 10s" Command="{Binding RewindClipCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Replay" Command="{Binding ReplayClipCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Save diagnosis WAV…" Command="{Binding SaveClipCommand}" Margin="0,0,8,8" Padding="12,8" />
                    <Button Content="Save before/after WAV…" Command="{Binding SaveComparisonCommand}" Margin="0,0,8,8" Padding="12,8"
                            ToolTip="One file: the same take without Muted, a short pause, then with Muted. Handy to show what it removes." />
                    <Button Content="Delete temporary clip" Command="{Binding DeleteClipCommand}" Margin="0,0,8,8" Padding="12,8" />
                </WrapPanel>
                <TextBlock Text="{Binding FeatureStatus}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Feedback &amp; session" />
                <CheckBox Content="Show speaking activity in the tray" IsChecked="{Binding SpeakingTrayEnabled}" Margin="0,12,0,8" />
                <CheckBox Content="Remind me when I speak while manually muted" IsChecked="{Binding MuteReminderEnabled}" Margin="0,0,0,8" />
                <CheckBox Content="Play push-to-talk open / close sounds" IsChecked="{Binding PushToTalkSoundsEnabled}" Margin="0,0,0,8" />
                <CheckBox Content="Warn about audio processing load and dropouts" IsChecked="{Binding HealthWarningsEnabled}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding HealthWarning}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding SessionText}" TextWrapping="Wrap" />
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Reset totals" Command="{Binding ResetLifetimeCommand}" Margin="12,0,0,0" Padding="10,6"
                            VerticalAlignment="Top" />
                    <TextBlock Text="{Binding LifetimeText}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Session statistics cover the current or last audio run and reset when audio restarts. The totals add up every run and are stored in the settings file as numbers only. Speaking time is an estimate; limiter events count separate attenuation periods. No session audio is stored automatically." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,60,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Clean what you hear" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Removes the noise in other people's audio too: their fans, keyboards and traffic. Set your call app's output to a second virtual cable (for example VB-CABLE A+B, or Voicemeeter), pick that cable's recording side below, and Muted plays the cleaned sound on your headphones. Runs separately from your microphone." />
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ToggleStyle}"
                              IsChecked="{Binding ListeningEnabled}" AutomationProperties.Name="Clean what you hear" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,14,0,6" Text="Listen to (the recording side of the cable your call app plays into)" />
                <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding ListeningInput}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="Device to clean" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,12,0,6" Text="Play on (headphones recommended)" />
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding ListeningOutput}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="Device to play the cleaned sound on" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="1" Value="{Binding ListeningStrength}" SmallChange="0.05" LargeChange="0.1"
                            AutomationProperties.Name="How much of what you hear is cleaned" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ListeningStrengthText}" />
                </Grid>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding ListeningStatus}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" Text="{Binding ListeningReductionText}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,24">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,60,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Automatic profiles" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Switch to a profile while a program runs, like Gaming for your game and Meeting for Teams. When it closes, the profile you had before comes back. The first match in the list wins." />
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ToggleStyle}"
                              IsChecked="{Binding AutoProfileEnabled}" AutomationProperties.Name="Automatic profiles" />
                </Grid>
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding AutoProfileRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4,0,0" Style="{StaticResource InsetCardStyle}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="10,4"
                                            Command="{Binding DataContext.RemoveAutoProfileRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Description}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding RunningPrograms}"
                              Text="{Binding NewRuleProcessName, UpdateSourceTrigger=PropertyChanged}"
                              DropDownOpened="RunningPrograms_OnDropDownOpened"
                              ToolTip="Type the program's name, like valorant or ms-teams, or open the list to pick one that is running."
                              AutomationProperties.Name="Program name" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding NewRuleProfile}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Profile to switch to" />
                    <Button Grid.Column="3" Margin="8,0,0,0" Content="Add" Padding="14,8" Command="{Binding AddAutoProfileRuleCommand}" />
                </Grid>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding AutoProfileStatus}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
