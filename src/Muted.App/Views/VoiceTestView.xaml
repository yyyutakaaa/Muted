<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Muted.App.Views.VoiceTestView">
    <StackPanel>
        <TextBlock Text="Voice test" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <WrapPanel>
            <Button Margin="0,0,10,8" AutomationProperties.Name="Record or stop a voice test">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
                        <Setter Property="Content" Value="Record a test"/>
                        <Setter Property="Command" Value="{Binding StartRecordingCommand}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="Content" Value="Stop recording"/>
                                <Setter Property="Command" Value="{Binding StopRecordingCommand}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseClipCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,10,8"/>
            <TextBlock Text="{Binding VoiceTestStateText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
        </WrapPanel>
        <Expander Header="Playback and recording details" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Playback device · use headphones" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Voice test playback device"/>
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="{Binding ClipDuration}" Value="{Binding ClipPosition}" AutomationProperties.Name="Test audio playback position"/>
                    <TextBlock Grid.Column="1" Text="{Binding ClipTimeText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <WrapPanel>
                    <Button Content="Replay" Command="{Binding ReplayClipCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="Delete test" Command="{Binding DeleteClipCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,8,8"/>
                    <Button Content="Save before / after WAV…" Command="{Binding SaveComparisonCommand}" Style="{StaticResource TextButtonStyle}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding FeatureStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,6,0,8"/>
                <TextBlock Text="Tests stay in memory until deleted or Muted closes. Only Save writes a WAV file locally." TextWrapping="Wrap"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
