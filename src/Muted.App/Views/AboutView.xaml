<UserControl x:Class="Muted.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Muted.App.Controls"
             Foreground="{DynamicResource TextBrush}">
    <!-- The About card at the bottom of Settings. -->
    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Width="40" Height="40" Source="pack://siteoforigin:,,,/icon.ico" Stretch="Uniform" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Muted" />
                    <TextBlock x:Name="VersionText" Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource CaptionStyle}"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Text="Muted sits between your microphone and your apps and removes the noise from your voice, on your own PC. Nothing is uploaded. Audio is only recorded when you start a voice test, and only Save writes it to a file." />
            <Rectangle Style="{StaticResource RowDividerStyle}" />
            <controls:SettingRow Title="Support Muted"
                                 Description="Muted is free and always will be. If it's useful to you, a coffee helps keep it maintained.">
                <Button Style="{StaticResource TextButtonStyle}" Padding="16,9" Click="SupportButton_OnClick" Content="Buy me a coffee"
                        AutomationProperties.Name="Support Muted on Buy Me a Coffee" />
            </controls:SettingRow>
            <Rectangle Style="{StaticResource RowDividerStyle}" />
            <TextBlock Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Text="Source available under the PolyForm Noncommercial License 1.0.0. Bundled: RNNoise (BSD-3-Clause), NAudio (MIT), ONNX Runtime (MIT), DeepFilterNet (MIT), DPDFNet (Apache-2.0), Whisper (MIT) and WeSpeaker (Apache-2.0). See LICENSE and THIRD-PARTY-NOTICES.md." />
        </StackPanel>
    </Border>
</UserControl>
